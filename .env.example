# FlightHub 2 y middleware instalados en el mismo servidor Linux.
# Si FlightHub 2 está en otro servidor, sustituye 127.0.0.1 por su IP o nombre.
FH2_URL=http://127.0.0.1:30812/openapi/v0.1/workflow
FH2_USER_TOKEN=
FH2_PROJECT_UUID=
FH2_WORKFLOW_UUID=
FH2_CREATOR_ID=
FH2_HOST_HEADER=

DEFAULT_LATITUDE=0
DEFAULT_LONGITUDE=0
DEFAULT_LEVEL=5
DEFAULT_DESCRIPTION=